    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {},
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0 <3.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.32",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
