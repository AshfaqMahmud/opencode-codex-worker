{
  "name": "opencode-codex-worker",
  "version": "0.1.0",
  "description": "Delegate coding tasks from OpenCode to the Codex CLI: synchronous tasks, background jobs, cancellation, and code review.",
  "type": "module",
  "license": "MIT",
  "author": "Ashfaq Mahmud",
  "homepage": "https://github.com/AshfaqMahmud/opencode-codex-worker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshfaqMahmud/opencode-codex-worker.git"
  },
  "bugs": {
    "url": "https://github.com/AshfaqMahmud/opencode-codex-worker/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codex",
    "openai",
    "agent",
    "worker",
    "subagent",
    "delegation"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "engines": {
